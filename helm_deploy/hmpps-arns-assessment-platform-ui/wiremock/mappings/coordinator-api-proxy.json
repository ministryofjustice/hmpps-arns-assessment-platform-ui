{
  "name": "Proxy to Coordinator API (training only, other environments call it directly)",
  "request": {
    "urlPattern": "/coordinator-api/.*"
  },
  "response": {
    "proxyBaseUrl": "{{systemValue type='ENVIRONMENT' key='WIREMOCK_COORDINATOR_API_URL'}}",
    "proxyUrlPrefixToRemove": "/coordinator-api"
  },
  "priority": 100
}

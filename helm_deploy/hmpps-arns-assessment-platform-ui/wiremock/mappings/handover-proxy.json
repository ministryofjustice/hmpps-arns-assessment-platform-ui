{
  "name": "Proxy to ARNS Handover (training only, other environments call it directly)",
  "request": {
    "urlPattern": "/handover/.*"
  },
  "response": {
    "proxyBaseUrl": "{{systemValue type='ENVIRONMENT' key='WIREMOCK_HANDOVER_URL'}}",
    "proxyUrlPrefixToRemove": "/handover"
  },
  "priority": 100
}

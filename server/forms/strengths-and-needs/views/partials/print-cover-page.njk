{% include "strengths-and-needs/views/components/print-header/index.njk" %}

<div class="govuk-grid-row pdf-cover-page">
  <div class="govuk-grid-column-two-thirds">
    <img class="pdf-cover-page__logo" src="/assets/images/moj-logo-large.png" height="95"/>
    <div class="pdf-cover-page__body page-break-after">
      <div class="pdf-cover-page__title">
        <p class="pdf-cover-page__subheading">His Majesty's Prison &amp; Probation Service</p>
        <p class="pdf-cover-page__heading">Strengths and needs</p>
      </div>
      <div class="pdf-cover-page__details">
        <p>Prepared by:</p>
        <p>
          <strong>
            {{ practitionerName }}<br/>
            {{ displayDateForToday() }}
          </strong>
        </p>
      </div>
    </div>
  </div>
</div>

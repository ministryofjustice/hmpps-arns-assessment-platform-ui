{%- extends "partials/layout.njk" -%}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{%- from "moj/components/domain-specific/probation/footer/macro.njk" import pdsFooter -%}
{%- from "govuk/components/error-summary/macro.njk" import govukErrorSummary -%}

{% set allValidationErrors = (fieldValidationErrors or []).concat(domainValidationErrors or []) %}

{# Each link names the tab that holds the field (details.tab), as the field may sit in a hidden tab #}
{% set errorSummaryList = [] %}
{% for item in allValidationErrors | toErrorSummary %}
  {% set error = allValidationErrors[loop.index0] %}
  {% set tab = error.details.tab if error.details else '' %}
  {% set _ = errorSummaryList.push({
    text: (tab + ': ' + item.text) if tab else item.text,
    href: item.href,
    attributes: item.attributes
  }) %}
{% endfor %}

{% block pageTitle %}{{ 'Error: ' if allValidationErrors.length }}{{ step.title }} - Training - {{ applicationName }}{% endblock %}

{% block head %}
  {{ super() }}
  {% block pageStylesheets %}
    <link rel="stylesheet" href="{{ '/assets/css/forms/training-session-launcher/assets/form.css' | assetMap }}">
  {% endblock %}
{% endblock %}

{% block govukHeader %}
  {{ super() }}
  {% set isOnBrowsePage = step.path == '/browse' %}
  {% set isOnCustomisePage = step.path == '/customise' %}
  {% set isOnSessionsPage = step.path == '/sessions' %}
  {% set isScenariosActive = isOnBrowsePage or isOnCustomisePage %}

  {{ govukServiceNavigation({
    serviceName: "Training",
    serviceUrl: "#",
    navigation: [
      {
        href: "/training-session-launcher/browse",
        text: "Scenarios",
        active: isScenariosActive
      },
      {
        href: "/training-session-launcher/sessions",
        text: "Your sessions",
        active: isOnSessionsPage
      }
    ]
  }) }}
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  {% block pageScripts %}
    <script src="{{ '/assets/js/forms/training-session-launcher/assets/form.js' | assetMap }}"></script>
  {% endblock %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if step.backlink %}
        <a href="{{ step.backlink }}" class="govuk-back-link">Back</a>
      {% endif %}

      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: errorSummaryList
      }) if allValidationErrors.length }}

      {% for block in blocks %}
        {{ block | safe }}
      {% endfor %}
    </div>
  </div>
{% endblock %}

{% set launcherHelpContent %}
  <h3 class="govuk-heading-s govuk-!-margin-bottom-2">Get help</h3>
  <p class="govuk-body-s govuk-!-margin-bottom-0">
    Please provide the request details shown here, along with a description of the issue you experienced.
  </p>
{% endset %}

{# Overrides the GOV.UK template's footer block, which would wrap these in a second footer landmark.
   The support widget sits outside the landmark, and the service footer is the only contentinfo. #}
{% block footer %}
  {{ supportWidget({
    helpContent: launcherHelpContent,
    supportItems: [
      { label: 'Preferences ID', value: data.preferencesId }
    ] if data.preferencesId else []
  }) }}

  {% if targetService == "sentence-plan" %}
    {% include "sentence-plan/components/custom-sentence-plan-footer/customSentencePlanFooter.njk" %}
  {% else %}
    {{ pdsFooter({
      baseUrl: footerBaseUrl or "/platform"
    }) }}
  {% endif %}
{% endblock %}

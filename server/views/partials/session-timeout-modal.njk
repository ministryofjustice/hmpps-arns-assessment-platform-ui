{# Timings from app.locals.sessionTimeoutConfig, wording from sessionTimeoutContent.ts #}
{% set timeoutContent = sessionTimeoutContentFor(targetService) %}
<moj-session-timeout-modal
  data-warning-after-inactive-seconds="{{ sessionTimeoutConfig.warningAfterInactiveSeconds }}"
  data-countdown-seconds="{{ sessionTimeoutConfig.countdownSeconds }}"
  data-timeout-redirect-url="/platform/session-timeout{% if targetService %}?service={{ targetService | urlencode }}{% endif %}"
  data-auth-source="{{ user.authSource if user else '' }}"
  data-csrf-token="{{ csrfToken }}"
  data-heading="{{ timeoutContent.modal.heading }}"
  data-description="{{ timeoutContent.modal.description }}"
  data-continue-text="{{ timeoutContent.modal.continueButtonText }}"
  data-leave-text="{{ timeoutContent.modal.leaveLinkText }}">
</moj-session-timeout-modal>

{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["es2022", "dom"],
    "types": ["@playwright/test"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["../server/*"],
      "@ministryofjustice/hmpps-aap-sdk/*": ["../packages/aap-sdk/src/*"],
      "@ministryofjustice/hmpps-arns-sentence-plan/*": [
        "../node_modules/@ministryofjustice/hmpps-arns-sentence-plan/src/*"
      ]
    }
  },
  "include": ["**/*.ts"]
}
